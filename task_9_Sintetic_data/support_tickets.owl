  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 1, "author_type": "staff", "text": "Банк обида академик порода падаль бетонный посидеть ныне.", "date": "2025-11-16 13:40:57"}, {"author_id": 832, "author_type": "user", "text": "Выбирать интернет кожа палец лететь шлем виднеться еврейский грудь поставить поймать.", "date": "2025-08-05 04:36:34"}, {"author_id": 6, "author_type": "staff", "text": "Деньги изучить заплакать подробность мера посидеть.", "date": "2026-03-23 18:28:01"}, {"author_id": 832, "author_type": "user", "text": "Оставить ночь изредка бочок число.", "date": "2025-10-23 11:27:59"}, {"author_id": 832, "author_type": "user", "text": "Непривычный тысяча валюта поставить социалистический мгновение протягивать боец ягода забирать.", "date": "2025-12-16 23:40:02"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2376">
