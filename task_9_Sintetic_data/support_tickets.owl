  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 7, "author_type": "staff", "text": "Какой уничтожение горький совещание мотоцикл неправда тяжелый рай прежде возмутиться.", "date": "2026-03-26 23:55:41"}, {"author_id": 7, "author_type": "user", "text": "Вскакивать расстройство о пространство бочок бак хозяйка поезд палец носок.", "date": "2026-03-02 07:08:43"}, {"author_id": 7, "author_type": "user", "text": "Головной невозможно боец вариант адвокат.", "date": "2025-10-19 09:07:09"}, {"author_id": 7, "author_type": "staff", "text": "Монета деньги цепочка выдержать труп пересечь выдержать горький.", "date": "2025-07-21 13:16:26"}]</комментарии_json>
