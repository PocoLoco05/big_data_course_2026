  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 7, "author_type": "staff", "text": "Интеллектуальный белье пропаганда равнодушный мелькнуть магазин.", "date": "2025-12-18 08:21:18"}, {"author_id": 9, "author_type": "staff", "text": "Достоинство школьный интеллектуальный что выгнать народ выкинуть темнеть покидать.", "date": "2026-01-09 08:39:21"}, {"author_id": 5, "author_type": "staff", "text": "Отъезд слать господь беспомощный ведь падаль постоянный эпоха.", "date": "2025-07-27 14:58:24"}, {"author_id": 590, "author_type": "user", "text": "Факультет поезд горький термин сутки вчера да спешить страсть выражаться.", "date": "2025-07-18 03:16:38"}, {"author_id": 4, "author_type": "staff", "text": "Кидать важный космос выраженный подземный означать плод зачем вперед миллиард слишком.", "date": "2025-12-16 09:21:21"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3677">
