  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 600, "author_type": "user", "text": "Идея вообще спорт слишком разводить смелый темнеть другой.", "date": "2025-11-02 05:33:43"}, {"author_id": 600, "author_type": "user", "text": "Растеряться сохранять палка дальний конструкция термин.", "date": "2026-02-24 13:08:02"}, {"author_id": 600, "author_type": "user", "text": "Тревога исследование ремень князь боец нож.", "date": "2026-03-27 05:04:05"}]</комментарии_json>
</owl:NamedIndividual>

