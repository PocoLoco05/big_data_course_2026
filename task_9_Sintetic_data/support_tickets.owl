  <относится_к_категории rdf:resource="#category_4"/>
  <назначается_сотруднику rdf:resource="#staff_3"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Процесс совет применяться.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Торговля палец монета услать. Мгновение потрясти куча каюта провинция анализ. Мотоцикл зеленый свежий порт появление.</описание>
