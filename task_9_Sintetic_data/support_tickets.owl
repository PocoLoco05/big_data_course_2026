  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 1, "author_type": "staff", "text": "Коммунизм мотоцикл сустав монета подробность приятель.", "date": "2026-04-08 07:14:49"}, {"author_id": 752, "author_type": "user", "text": "Хозяйка находить господь плод магазин процесс.", "date": "2025-12-31 05:37:52"}, {"author_id": 752, "author_type": "user", "text": "Нажать налево художественный покинуть устройство поговорить висеть кидать.", "date": "2026-05-11 03:42:57"}, {"author_id": 10, "author_type": "staff", "text": "Торопливый триста хотеть да умирать тысяча нажать парень степь фонарик сбросить.", "date": "2025-10-26 17:56:33"}, {"author_id": 752, "author_type": "user", "text": "Горький стакан миф издали потянуться освобождение сходить.", "date": "2026-03-13 17:17:13"}]</комментарии_json>
