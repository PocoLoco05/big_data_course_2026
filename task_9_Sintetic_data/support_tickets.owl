  <назначается_сотруднику rdf:resource="#staff_8"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Добиться разуметься кожа собеседник господь.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поезд потянуться ярко отметить. Зато костер сустав солнце район постоянный нож. Направо выразить экзамен демократия. Растеряться штаб нож носок.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-02-11 14:33:11</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 659, "author_type": "user", "text": "Июнь стакан затянуться выбирать шлем темнеть июнь вскинуть инвалид.", "date": "2025-07-05 22:03:45"}, {"author_id": 659, "author_type": "user", "text": "Актриса расстегнуть ход сверкать палата крутой о.", "date": "2026-04-05 00:38:58"}, {"author_id": 659, "author_type": "user", "text": "Светило темнеть услать тревога еврейский заявление единый порода.", "date": "2026-03-03 07:19:54"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2640">
