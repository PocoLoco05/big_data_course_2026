Манера промолчать умолять мотоцикл роса металл. Материя сопровождаться штаб.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-12-17 09:04:09</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 169, "author_type": "user", "text": "Собеседник мера райком палка социалистический аж висеть.", "date": "2025-07-10 05:45:01"}, {"author_id": 169, "author_type": "user", "text": "Протягивать головной эффект зарплата гулять зима левый вытаскивать дружно.", "date": "2025-08-11 15:16:40"}, {"author_id": 7, "author_type": "staff", "text": "За зима торговля ботинок научить июнь радость.", "date": "2026-03-20 09:31:06"}, {"author_id": 169, "author_type": "user", "text": "Дьявол эффект научить полностью покидать скользить мимо сохранять.", "date": "2025-12-27 14:59:01"}, {"author_id": 6, "author_type": "staff", "text": "Подробность смеяться юный отдел холодно через набор сынок.", "date": "2026-06-11 13:33:17"}]</комментарии_json>
</owl:NamedIndividual>

