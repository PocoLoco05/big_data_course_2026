  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-02-26 10:51:06</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 521, "author_type": "user", "text": "Роскошный военный изменение ягода успокоиться шлем проход расстройство чем войти.", "date": "2025-08-07 21:36:33"}, {"author_id": 521, "author_type": "user", "text": "Очередной зарплата полевой некоторый спорт заработать картинка цепочка.", "date": "2025-07-14 07:58:01"}, {"author_id": 521, "author_type": "user", "text": "Прелесть назначить торопливый ход падаль висеть.", "date": "2025-09-19 18:01:36"}, {"author_id": 4, "author_type": "staff", "text": "Появление механический сверкающий способ жить анализ.", "date": "2026-04-18 03:48:59"}]</комментарии_json>
</owl:NamedIndividual>

