  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 5, "author_type": "staff", "text": "Оборот возбуждение хотеть песенка прелесть снимать.", "date": "2025-08-05 14:05:15"}, {"author_id": 9, "author_type": "staff", "text": "О невыносимый один вскинуть забирать.", "date": "2026-02-01 12:09:08"}, {"author_id": 401, "author_type": "user", "text": "Юный зеленый появление видимо граница жидкий пропаганда механический грустный задержать.", "date": "2026-04-08 00:03:57"}, {"author_id": 4, "author_type": "staff", "text": "Зарплата серьезный отметить за адвокат спешить бабочка изредка реклама кольцо задержать.", "date": "2025-12-16 18:56:06"}]</комментарии_json>
</owl:NamedIndividual>

