  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 4, "author_type": "staff", "text": "Бровь головной жестокий прежний назначить очко.", "date": "2025-11-03 23:52:25"}, {"author_id": 965, "author_type": "user", "text": "Мгновение помимо бок багровый заявление.", "date": "2025-07-25 03:49:23"}, {"author_id": 5, "author_type": "staff", "text": "Возмутиться близко лететь возбуждение бок успокоиться заявление выбирать.", "date": "2026-05-09 09:56:09"}, {"author_id": 8, "author_type": "staff", "text": "Крыса бочок решетка гулять около пол скользить развитый.", "date": "2025-11-22 17:37:55"}, {"author_id": 965, "author_type": "user", "text": "Кольцо факультет сверкать полевой заплакать мусор материя невыносимый следовательно.", "date": "2025-07-07 02:42:02"}]</комментарии_json>
</owl:NamedIndividual>

