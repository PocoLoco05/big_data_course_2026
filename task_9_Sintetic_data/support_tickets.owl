  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 1, "author_type": "staff", "text": "Заплакать актриса мимо жидкий порог сверкать миллиард вряд.", "date": "2026-02-25 12:18:21"}, {"author_id": 8, "author_type": "staff", "text": "Правый прелесть мальчишка человечек монета советовать разуметься.", "date": "2026-05-07 19:30:22"}, {"author_id": 198, "author_type": "user", "text": "Пламя функция изображать ручей разнообразный около.", "date": "2025-11-09 17:03:16"}, {"author_id": 6, "author_type": "staff", "text": "Число низкий оставить монета магазин дыхание лиловый сынок изредка бровь что.", "date": "2025-08-10 17:14:38"}]</комментарии_json>
</owl:NamedIndividual>

