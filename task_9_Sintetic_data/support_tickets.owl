  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 2, "author_type": "staff", "text": "Выраженный фонарик угол процесс услать очередной.", "date": "2026-01-10 05:57:30"}, {"author_id": 166, "author_type": "user", "text": "Болото конструкция изба мрачно ответить поздравлять.", "date": "2026-03-07 01:04:11"}, {"author_id": 6, "author_type": "staff", "text": "Гулять покидать прежний дурацкий увеличиваться освободить ярко лететь.", "date": "2025-10-13 09:20:26"}, {"author_id": 166, "author_type": "user", "text": "Порода ставить поколение пропадать девка вздрогнуть полевой счастье исполнять провинция.", "date": "2026-05-12 03:35:01"}]</комментарии_json>
