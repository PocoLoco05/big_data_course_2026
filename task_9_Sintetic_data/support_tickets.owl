  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 309, "author_type": "user", "text": "Рис упорно идея изба рай исполнять понятный конференция человечек войти.", "date": "2025-09-27 16:48:08"}, {"author_id": 309, "author_type": "user", "text": "Естественный цепочка дружно художественный выражение полностью трубка издали тута уронить.", "date": "2026-06-07 15:42:51"}, {"author_id": 9, "author_type": "staff", "text": "Даль естественный механический а граница сопровождаться.", "date": "2025-08-09 03:46:58"}, {"author_id": 309, "author_type": "user", "text": "Возбуждение ярко налоговый художественный изба очко лететь выраженный.", "date": "2026-02-11 02:47:44"}, {"author_id": 309, "author_type": "user", "text": "Миг при некоторый совет совет исполнять космос правление командир второй.", "date": "2025-07-05 00:42:32"}]</комментарии_json>
</owl:NamedIndividual>

