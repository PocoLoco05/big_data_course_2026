  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 10, "author_type": "staff", "text": "Провинция порядок развитый темнеть да единый дошлый механический полевой райком.", "date": "2026-03-04 11:10:15"}, {"author_id": 3, "author_type": "staff", "text": "Что металл выгнать солнце один ночь посвятить возникновение ответить господь.", "date": "2025-11-08 18:19:58"}, {"author_id": 6, "author_type": "staff", "text": "Нож наступать трясти аж о цвет нажать покинуть армейский.", "date": "2026-01-14 15:23:21"}, {"author_id": 2, "author_type": "staff", "text": "Чувство коробка жить правление ныне порода подробность.", "date": "2025-08-09 19:55:13"}, {"author_id": 6, "author_type": "staff", "text": "Отдел правильный мотоцикл поезд покидать.", "date": "2025-08-15 14:25:38"}]</комментарии_json>
</owl:NamedIndividual>

