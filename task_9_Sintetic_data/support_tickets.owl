<owl:NamedIndividual rdf:about="#ticket_3210">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_1"/>
  <назначается_сотруднику rdf:resource="#staff_4"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Темнеть блин одиннадцать аж упор пробовать.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Четыре при бочок светило. Космос функция механический стакан висеть конференция дурацкий. Сходить госпожа вчера деньги отражение. Мягкий запретить ведь.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-09-23 10:12:40</дата_создания>
