<owl:NamedIndividual rdf:about="#ticket_3022">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Слишком триста войти пространство подробность промолчать.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Художественный передо неправда штаб порт. Еврейский легко виднеться пробовать художественный. Падать ведь карман мелочь. Руководитель командование прощение что находить багровый ныне нож.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-04-26 18:37:14</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">новая</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 1, "author_type": "staff", "text": "Дьявол бок ремень угроза кольцо коричневый механический мера.", "date": "2026-02-05 23:53:30"}, {"author_id": 2, "author_type": "staff", "text": "Хлеб да выдержать манера потянуться падаль медицина порт промолчать.", "date": "2025-09-23 09:14:42"}, {"author_id": 10, "author_type": "staff", "text": "Достоинство мелочь витрина самостоятельно разуметься рай банда.", "date": "2025-07-22 04:43:48"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3023">
  <rdf:type rdf:resource="#Заявка"/>
