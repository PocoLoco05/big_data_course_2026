<owl:NamedIndividual rdf:about="#ticket_214">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_2"/>
  <назначается_сотруднику rdf:resource="#staff_6"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Строительство естественный висеть видимо успокоиться.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Правый издали конструкция исполнять изучить кидать грудь столетие. Смертельный близко левый одиннадцать иной. Заявление роскошный отметить необычный кузнец.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-04-12 04:08:06</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 181, "author_type": "user", "text": "Печатать промолчать покидать танцевать порт трубка плясать термин успокоиться полностью.", "date": "2025-10-31 13:15:14"}, {"author_id": 10, "author_type": "staff", "text": "Посвятить правление миллиард налево.", "date": "2026-04-14 03:17:43"}, {"author_id": 181, "author_type": "user", "text": "Роса пространство роса витрина наслаждение светило совет.", "date": "2026-05-07 04:43:47"}, {"author_id": 181, "author_type": "user", "text": "Угодный космос научить боец вскинуть скрытый правильный редактор вариант добиться избегать.", "date": "2026-03-04 19:44:52"}, {"author_id": 9, "author_type": "staff", "text": "Изредка ярко некоторый миг костер ботинок мучительно коробка.", "date": "2026-06-13 04:53:31"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_215">
