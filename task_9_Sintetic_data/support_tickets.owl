</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3726">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_4"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зачем сынок голубчик.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Левый левый монета счастье выраженный следовательно. Серьезный князь спалить трясти карандаш даль. Выбирать белье банк. Лиловый заведение дошлый труп умолять лететь.</описание>
