  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 364, "author_type": "user", "text": "Расстройство солнце запустить избегать бетонный сынок трубка разводить изображать горький.", "date": "2026-02-12 15:39:33"}, {"author_id": 4, "author_type": "staff", "text": "Вперед спорт выгнать термин вперед.", "date": "2025-12-19 08:55:40"}, {"author_id": 5, "author_type": "staff", "text": "Направо район слишком недостаток порт задержать райком лететь кузнец.", "date": "2025-09-15 17:03:49"}]</комментарии_json>
