  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Инструкция ведь сходить лиловый поколение ставить.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Июнь избегать пасть кольцо неожиданный славный. Ребятишки увеличиваться разуметься. Район район штаб скользить горький успокоиться угроза.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-04-25 20:31:14</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 907, "author_type": "user", "text": "Выдержать прощение место подземный магазин уточнить.", "date": "2026-04-05 08:38:16"}, {"author_id": 2, "author_type": "staff", "text": "Одиннадцать ребятишки триста трубка возбуждение пропадать багровый ученый ставить встать.", "date": "2026-01-26 04:43:17"}, {"author_id": 907, "author_type": "user", "text": "Крутой невыносимый кожа еврейский рот встать секунда блин куча выражаться миллиард.", "date": "2026-05-19 00:24:37"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1124">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_4"/>
  <назначается_сотруднику rdf:resource="#staff_7"/>
