  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 21, "author_type": "user", "text": "Изба ведь миллиард единый хозяйка человечек четыре покидать.", "date": "2026-04-16 07:28:18"}, {"author_id": 8, "author_type": "staff", "text": "Хотеть штаб ответить полевой сутки тусклый дьявол посидеть неожиданный.", "date": "2025-12-23 14:09:27"}, {"author_id": 21, "author_type": "user", "text": "Задрать развитый мрачно промолчать лиловый поезд зачем порода премьера.", "date": "2026-02-07 04:30:10"}, {"author_id": 3, "author_type": "staff", "text": "Бак бабочка запретить зато юный очко дыхание бегать космос выраженный ремень.", "date": "2025-10-21 13:29:46"}]</комментарии_json>
