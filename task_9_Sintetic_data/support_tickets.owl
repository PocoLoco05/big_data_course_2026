  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 10, "author_type": "staff", "text": "Коробка развернуться расстройство домашний заплакать песенка.", "date": "2026-02-02 06:10:06"}, {"author_id": 1, "author_type": "staff", "text": "Применяться процесс скрытый стакан похороны.", "date": "2026-01-14 04:14:17"}, {"author_id": 909, "author_type": "user", "text": "Коробка исследование затянуться сверкать палата миф.", "date": "2025-11-30 20:47:04"}, {"author_id": 909, "author_type": "user", "text": "Труп плод теория адвокат пересечь труп дорогой актриса.", "date": "2026-05-29 06:45:33"}, {"author_id": 909, "author_type": "user", "text": "Мелочь мимо недостаток какой район народ коллектив триста.", "date": "2025-06-30 08:37:11"}]</комментарии_json>
