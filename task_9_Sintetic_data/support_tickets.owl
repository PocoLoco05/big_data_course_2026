  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 360, "author_type": "user", "text": "Приходить остановить промолчать вряд спешить поколение достоинство пространство.", "date": "2026-05-12 00:06:31"}, {"author_id": 9, "author_type": "staff", "text": "Лапа школьный смертельный угроза появление помимо горький.", "date": "2025-10-27 11:47:47"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3199">
