  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 2, "author_type": "staff", "text": "Ребятишки слать совет приличный крыса космос близко запретить.", "date": "2025-12-18 06:44:54"}, {"author_id": 8, "author_type": "staff", "text": "Дружно лететь счастье более решение приличный остановить.", "date": "2026-05-02 17:09:29"}, {"author_id": 2, "author_type": "staff", "text": "Правление бригада секунда смертельный.", "date": "2026-05-15 16:49:12"}, {"author_id": 1, "author_type": "staff", "text": "Видимо спичка грудь изредка июнь выкинуть ботинок.", "date": "2026-01-29 11:50:01"}]</комментарии_json>
</owl:NamedIndividual>

