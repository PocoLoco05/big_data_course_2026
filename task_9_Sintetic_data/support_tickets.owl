  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 6, "author_type": "staff", "text": "Болото бак тюрьма правление запеть мелькнуть засунуть.", "date": "2026-06-07 03:00:52"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_63">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_1"/>
  <назначается_сотруднику rdf:resource="#staff_5"/>
