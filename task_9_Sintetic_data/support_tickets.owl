  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 151, "author_type": "user", "text": "Добиться господь вообще жестокий домашний.", "date": "2025-12-30 13:04:03"}, {"author_id": 9, "author_type": "staff", "text": "Пространство место июнь уточнить выкинуть передо доставать деньги.", "date": "2025-12-30 01:56:20"}, {"author_id": 10, "author_type": "staff", "text": "Выразить горький идея приятель направо дремать.", "date": "2025-08-07 10:46:26"}, {"author_id": 151, "author_type": "user", "text": "Разнообразный поставить мгновение забирать зима.", "date": "2025-12-10 06:08:26"}, {"author_id": 4, "author_type": "staff", "text": "Зарплата пламя ботинок конференция крутой.", "date": "2026-02-28 02:33:35"}]</комментарии_json>
</owl:NamedIndividual>

