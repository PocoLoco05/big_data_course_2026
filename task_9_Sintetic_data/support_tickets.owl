  <назначается_сотруднику rdf:resource="#staff_1"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Идея наслаждение неожиданный юный горький приятель.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Через горький терапия. Ученый рай нож роса природа. Пол понятный военный песня покинуть.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-06-24 12:09:51</дата_создания>
