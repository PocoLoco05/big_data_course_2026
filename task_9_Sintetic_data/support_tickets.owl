  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 297, "author_type": "user", "text": "Поколение госпожа услать угроза витрина спорт палата.", "date": "2026-04-30 21:22:31"}, {"author_id": 9, "author_type": "staff", "text": "Головной горький песенка написать остановить наткнуться дурацкий потянуться ломать.", "date": "2025-08-17 03:51:45"}, {"author_id": 5, "author_type": "staff", "text": "Лететь пасть дальний шлем ученый светило набор важный эпоха.", "date": "2025-08-11 15:37:41"}, {"author_id": 8, "author_type": "staff", "text": "Устройство господь уронить через деловой развитый бегать равнодушный.", "date": "2025-08-25 11:49:59"}, {"author_id": 5, "author_type": "staff", "text": "Мрачно покидать порода материя присесть триста.", "date": "2025-09-16 14:14:18"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3271">
