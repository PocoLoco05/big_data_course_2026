</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_4714">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_5"/>
  <назначается_сотруднику rdf:resource="#staff_3"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Приятель кузнец факультет мягкий.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Полюбить холодно дремать спичка увеличиваться висеть. Ведь сутки радость военный забирать головной. Цель за академик степь следовательно коричневый.</описание>
