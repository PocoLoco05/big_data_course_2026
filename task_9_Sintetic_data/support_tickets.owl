</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2074">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выражение руководитель слать.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Четыре сынок лететь горький устройство плясать деловой. Деловой домашний запретить дорогой команда.
Инструкция очко сравнение тута.
Командующий снимать провинция страсть. Дрогнуть термин невозможно.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-02-04 04:42:10</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">критический</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 225, "author_type": "user", "text": "Присесть призыв висеть порог господь.", "date": "2026-01-15 10:35:27"}, {"author_id": 4, "author_type": "staff", "text": "Пересечь эффект поздравлять человечек место витрина покидать функция.", "date": "2025-10-25 06:17:17"}, {"author_id": 225, "author_type": "user", "text": "Понятный валюта отражение дьявол поставить избегать встать применяться.", "date": "2026-03-18 08:48:13"}, {"author_id": 8, "author_type": "staff", "text": "Триста дурацкий уронить угол ярко невозможно понятный командир монета ребятишки карман.", "date": "2025-12-07 19:44:56"}, {"author_id": 225, "author_type": "user", "text": "Дошлый аллея пол жидкий школьный построить карандаш подробность.", "date": "2026-04-09 18:42:01"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2075">
