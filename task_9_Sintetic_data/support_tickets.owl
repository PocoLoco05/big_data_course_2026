  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 10, "author_type": "staff", "text": "Видимо число народ мальчишка упорно провинция проход видимо темнеть другой.", "date": "2025-07-16 09:37:19"}, {"author_id": 9, "author_type": "staff", "text": "Пастух падаль новый роса идея выкинуть лиловый добиться провал виднеться.", "date": "2025-08-23 18:47:53"}, {"author_id": 8, "author_type": "staff", "text": "Космос жить нажать потрясти кожа механический песенка очко солнце.", "date": "2026-03-23 09:39:23"}, {"author_id": 10, "author_type": "staff", "text": "Поздравлять слать отметить свежий степь факультет.", "date": "2025-07-08 08:29:52"}, {"author_id": 436, "author_type": "user", "text": "Вздрагивать актриса юный школьный изучить уничтожение.", "date": "2025-08-05 04:23:32"}]</комментарии_json>
