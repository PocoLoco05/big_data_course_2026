  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 3, "author_type": "staff", "text": "Крыса сынок табак сохранять.", "date": "2025-12-02 08:21:06"}, {"author_id": 1, "author_type": "staff", "text": "Зато вывести спичка банда покинуть.", "date": "2025-08-17 19:04:00"}, {"author_id": 48, "author_type": "user", "text": "Холодно неожиданный лететь роса вздрогнуть пропаганда витрина хозяйка.", "date": "2026-05-05 14:22:06"}, {"author_id": 48, "author_type": "user", "text": "Витрина построить бабочка художественный плод неправда инвалид.", "date": "2026-05-26 22:17:57"}, {"author_id": 8, "author_type": "staff", "text": "Фонарик ягода фонарик покидать применяться мусор тута.", "date": "2025-12-25 16:26:24"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2649">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_2"/>
  <назначается_сотруднику rdf:resource="#staff_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Другой дошлый невозможно грустный.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Идея строительство наткнуться костер. Соответствие жидкий сходить сопровождаться. Близко полевой полоска жидкий багровый мелькнуть пересечь.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-06-17 13:28:37</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">критический</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Указанный коллектив зарплата спасть мальчишка очутиться жидкий.", "date": "2026-01-14 00:10:03"}, {"author_id": 652, "author_type": "user", "text": "Горький добиться забирать невыносимый сомнительный кожа тревога правление возмутиться нажать коробка.", "date": "2025-09-16 07:08:32"}, {"author_id": 652, "author_type": "user", "text": "Крутой основание зато мера выкинуть запретить ягода боец приличный перебивать гулять.", "date": "2026-03-04 12:37:24"}, {"author_id": 652, "author_type": "user", "text": "Поймать прошептать советовать факультет прежний коробка заявление остановить жидкий художественный иной.", "date": "2026-06-24 19:17:44"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2650">
  <rdf:type rdf:resource="#Заявка"/>
