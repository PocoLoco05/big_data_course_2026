  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 240, "author_type": "user", "text": "Налево плавно похороны вскинуть точно сверкать помолчать невыносимый блин уничтожение.", "date": "2025-12-05 10:16:37"}, {"author_id": 240, "author_type": "user", "text": "Зеленый самостоятельно тысяча госпожа премьера ягода ныне вариант степь.", "date": "2025-10-15 18:43:07"}, {"author_id": 10, "author_type": "staff", "text": "Темнеть основание висеть миф космос а мусор порядок роса отражение.", "date": "2026-01-11 01:21:06"}, {"author_id": 9, "author_type": "staff", "text": "Привлекать интеллектуальный ответить возможно.", "date": "2025-09-09 00:00:53"}, {"author_id": 10, "author_type": "staff", "text": "Да рис советовать вообще тревога радость другой заплакать недостаток заработать изредка.", "date": "2026-01-25 15:26:49"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2648">
  <rdf:type rdf:resource="#Заявка"/>
