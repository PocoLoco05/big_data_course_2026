  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 173, "author_type": "user", "text": "Передо команда желание уточнить обида некоторый.", "date": "2026-04-11 11:54:45"}, {"author_id": 2, "author_type": "staff", "text": "Кольцо коммунизм дремать ленинград.", "date": "2025-07-21 13:08:10"}, {"author_id": 10, "author_type": "staff", "text": "Около правый результат неожиданно неправда бровь наслаждение тысяча мелькнуть передо падаль.", "date": "2025-10-27 05:10:25"}, {"author_id": 10, "author_type": "staff", "text": "Плясать падать выраженный юный исполнять перебивать.", "date": "2025-12-26 17:47:22"}]</комментарии_json>
</owl:NamedIndividual>

