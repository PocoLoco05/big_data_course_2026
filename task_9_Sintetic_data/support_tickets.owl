  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 4, "author_type": "staff", "text": "Теория покинуть карман умолять жидкий выразить жидкий райком вперед.", "date": "2025-08-08 05:52:33"}, {"author_id": 36, "author_type": "user", "text": "Провинция функция правление природа потом ремень спорт неправда холодно природа.", "date": "2026-02-04 23:58:33"}, {"author_id": 36, "author_type": "user", "text": "Художественный иной кидать сынок вытаскивать трясти жить.", "date": "2025-10-15 17:55:34"}, {"author_id": 36, "author_type": "user", "text": "Недостаток куча зарплата сынок привлекать торопливый прелесть развитый.", "date": "2026-04-28 16:11:34"}]</комментарии_json>
</owl:NamedIndividual>

