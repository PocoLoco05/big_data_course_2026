  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 6, "author_type": "staff", "text": "Салон роскошный команда присесть слишком цель социалистический.", "date": "2026-01-05 05:36:27"}, {"author_id": 3, "author_type": "staff", "text": "Очутиться медицина тревога миф наступать материя.", "date": "2025-07-14 03:47:01"}, {"author_id": 8, "author_type": "staff", "text": "Бочок валюта изображать указанный недостаток пространство нервно.", "date": "2025-10-03 07:45:50"}, {"author_id": 1, "author_type": "staff", "text": "Расстегнуть отражение потянуться карандаш точно сопровождаться упорно.", "date": "2025-11-23 18:11:46"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3032">
  <rdf:type rdf:resource="#Заявка"/>
