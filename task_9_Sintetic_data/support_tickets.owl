  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 8, "author_type": "staff", "text": "Пробовать да потрясти достоинство сынок дьявол возмутиться.", "date": "2026-03-21 17:04:39"}, {"author_id": 9, "author_type": "staff", "text": "Товар командир самостоятельно школьный ставить славный.", "date": "2026-03-31 02:03:43"}, {"author_id": 74, "author_type": "user", "text": "Житель сверкать способ низкий кожа решетка ботинок достоинство ленинград обида.", "date": "2026-06-11 14:53:09"}, {"author_id": 74, "author_type": "user", "text": "Ягода упорно прежде ярко ручей труп избегать вариант.", "date": "2025-08-04 11:10:15"}, {"author_id": 8, "author_type": "staff", "text": "Ответить падаль выкинуть терапия обида адвокат штаб налоговый.", "date": "2026-02-23 07:29:53"}]</комментарии_json>
