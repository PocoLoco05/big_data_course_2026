  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 3, "author_type": "staff", "text": "Художественный выражение грудь тревога деньги остановить полоска пол.", "date": "2025-12-21 16:47:27"}, {"author_id": 1, "author_type": "staff", "text": "Торопливый премьера коробка решетка рассуждение анализ жидкий.", "date": "2025-12-27 02:12:15"}, {"author_id": 538, "author_type": "user", "text": "Изменение зато сынок коричневый.", "date": "2025-08-13 08:53:37"}]</комментарии_json>
</owl:NamedIndividual>

