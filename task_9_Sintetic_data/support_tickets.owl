  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 940, "author_type": "user", "text": "Болото какой сустав указанный спорт чем фонарик.", "date": "2025-12-02 17:00:57"}, {"author_id": 5, "author_type": "staff", "text": "Теория постоянный прошептать бригада сынок миг услать проход.", "date": "2026-01-07 16:14:56"}, {"author_id": 940, "author_type": "user", "text": "Неправда тревога зато песенка применяться совещание.", "date": "2025-07-30 23:04:57"}, {"author_id": 940, "author_type": "user", "text": "Командование дружно выражение промолчать сустав увеличиваться палата вывести гулять госпожа.", "date": "2025-12-07 19:13:17"}, {"author_id": 940, "author_type": "user", "text": "Лететь пасть вскакивать зато невыносимый.", "date": "2026-02-07 14:10:12"}]</комментарии_json>
</owl:NamedIndividual>

