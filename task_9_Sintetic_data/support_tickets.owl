  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 7, "author_type": "staff", "text": "Невыносимый настать пространство тревога стакан изучить пропасть багровый при невыносимый.", "date": "2026-03-15 20:47:46"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1128">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_1"/>
  <назначается_сотруднику rdf:resource="#staff_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Висеть изучить заведение теория.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ответить появление жидкий. Тюрьма картинка покинуть вряд намерение отдел. Тесно угроза слишком госпожа.
Бровь чувство вариант развернуться. Светило крутой сынок конференция волк коробка палка.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-27 08:33:58</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Спорт ленинград скрытый видимо недостаток.", "date": "2025-08-26 09:47:38"}, {"author_id": 8, "author_type": "staff", "text": "Привлекать нажать валюта изображать эпоха скользить низкий.", "date": "2026-06-22 17:39:25"}, {"author_id": 9, "author_type": "staff", "text": "Художественный близко покидать отъезд видимо дорогой.", "date": "2025-09-15 01:04:39"}, {"author_id": 2, "author_type": "staff", "text": "Песенка запеть порог результат песня да наткнуться передо табак потом.", "date": "2026-04-27 07:27:55"}, {"author_id": 433, "author_type": "user", "text": "Факультет мрачно ботинок космос результат салон светило конференция шлем.", "date": "2026-01-20 09:12:16"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1129">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_5"/>
  <назначается_сотруднику rdf:resource="#staff_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дружно отъезд бабочка зато бок.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Витрина мера заведение спалить указанный прежний. Появление господь выкинуть ответить полюбить. Поставить тусклый коричневый плавно изучить подробность рис возможно.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-01-17 19:16:46</дата_создания>
