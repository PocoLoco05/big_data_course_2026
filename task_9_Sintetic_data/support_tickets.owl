  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Смертельный скрытый необычный академик мучительно отражение ставить выражаться сравнение.", "date": "2025-12-14 18:00:30"}, {"author_id": 761, "author_type": "user", "text": "Деньги домашний задрать бровь триста рассуждение плавно ставить настать сохранять сверкать.", "date": "2026-01-09 12:44:06"}, {"author_id": 9, "author_type": "staff", "text": "Вздрогнуть решение виднеться дьявол возмутиться мимо бочок плод.", "date": "2026-04-25 22:40:24"}]</комментарии_json>
</owl:NamedIndividual>

