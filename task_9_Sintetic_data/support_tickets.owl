</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1309">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_7"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Появление покинуть роса прелесть.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Снимать тревога полностью угодный порт.
Манера четыре выгнать ярко возможно. Головной прежде бегать кпсс ярко. Заведение заплакать налево медицина счастье прелесть изба ребятишки.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-10-28 09:27:37</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">закрыта</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 10, "author_type": "staff", "text": "Расстройство аж мгновение доставать естественный советовать порт роса еврейский.", "date": "2025-10-14 02:36:56"}, {"author_id": 9, "author_type": "staff", "text": "Единый понятный шлем лететь зато стакан следовательно миф возможно освободить.", "date": "2026-05-06 12:20:14"}, {"author_id": 4, "author_type": "staff", "text": "Услать командующий выразить возникновение низкий экзамен доставать деньги сходить указанный.", "date": "2025-07-03 11:51:57"}, {"author_id": 5, "author_type": "staff", "text": "Цвет порог прежний ведь спалить.", "date": "2025-10-13 08:10:27"}, {"author_id": 4, "author_type": "staff", "text": "Мгновение место райком тусклый манера.", "date": "2025-08-25 06:00:07"}]</комментарии_json>
</owl:NamedIndividual>

