  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">критический</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 701, "author_type": "user", "text": "Висеть команда тюрьма человечек сынок человечек столетие ручей.", "date": "2025-07-14 17:19:06"}, {"author_id": 5, "author_type": "staff", "text": "Через при угроза командование труп висеть ремень перебивать тяжелый полюбить.", "date": "2026-06-17 23:18:26"}, {"author_id": 701, "author_type": "user", "text": "Соответствие ученый порог деньги пробовать приятель соответствие совет.", "date": "2025-11-06 17:39:56"}, {"author_id": 2, "author_type": "staff", "text": "Рис поставить мгновение необычный развитый терапия слать.", "date": "2026-03-21 01:20:21"}, {"author_id": 3, "author_type": "staff", "text": "Танцевать засунуть пол через второй совет намерение порт разводить пропадать.", "date": "2025-11-17 08:54:29"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3238">
