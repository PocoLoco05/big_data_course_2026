  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 774, "author_type": "user", "text": "Факультет опасность упор невыносимый пространство палец светило.", "date": "2025-08-13 04:04:45"}, {"author_id": 10, "author_type": "staff", "text": "Коричневый граница мрачно куча художественный.", "date": "2026-02-03 20:10:59"}, {"author_id": 774, "author_type": "user", "text": "Цвет спасть важный избегать поколение трясти потянуться пастух хозяйка посидеть полностью.", "date": "2025-12-04 10:14:53"}, {"author_id": 774, "author_type": "user", "text": "Расстройство уничтожение рота бегать тюрьма неправда прошептать казнь войти.", "date": "2026-06-20 09:00:06"}, {"author_id": 774, "author_type": "user", "text": "Поставить вообще около нож дошлый.", "date": "2026-03-21 07:26:00"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3027">
