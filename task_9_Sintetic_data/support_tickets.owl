  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Сынок оборот мимо дорогой.", "date": "2025-09-10 16:20:13"}, {"author_id": 2, "author_type": "staff", "text": "Вздрагивать руководитель выбирать приятель.", "date": "2026-01-28 17:23:04"}, {"author_id": 9, "author_type": "staff", "text": "Пропаганда миг назначить цвет избегать развернуться горький посидеть появление материя.", "date": "2026-01-12 23:54:59"}, {"author_id": 6, "author_type": "staff", "text": "Наслаждение прежний господь исследование ночь собеседник теория запеть.", "date": "2025-11-07 22:34:21"}, {"author_id": 644, "author_type": "user", "text": "Школьный изменение вряд редактор важный близко важный вообще космос.", "date": "2026-03-26 18:30:29"}]</комментарии_json>
</owl:NamedIndividual>

