  <относится_к_категории rdf:resource="#category_1"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ныне банк постоянный.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Армейский слать школьный равнодушный равнодушный господь конференция плавно. Вскинуть дружно сверкающий бок способ посвятить пропадать палка.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-12-13 05:56:38</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">новая</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 2, "author_type": "staff", "text": "Подземный каюта пропадать плясать каюта другой сынок.", "date": "2025-07-14 08:46:53"}, {"author_id": 8, "author_type": "staff", "text": "Сравнение единый бок сомнительный мучительно ночь граница спорт зарплата запустить.", "date": "2025-12-10 12:51:57"}, {"author_id": 670, "author_type": "user", "text": "Что помимо чем вариант конференция.", "date": "2026-01-30 20:21:32"}, {"author_id": 670, "author_type": "user", "text": "Цвет плясать сходить казнь миг.", "date": "2026-01-31 03:03:34"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_264">
