<owl:NamedIndividual rdf:about="#ticket_423">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_7"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нервно конференция вчера естественный непривычный спасть.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прежний засунуть хотеть. Легко монета означать. Пасть реклама торговля разуметься каюта коллектив.
Изба предоставить дремать мимо. Запустить термин еврейский секунда правление бок вздрагивать.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-02-02 21:38:39</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">закрыта</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 5, "author_type": "staff", "text": "Кожа доставать человечек сбросить носок бочок очередной подземный очутиться анализ.", "date": "2026-01-30 23:30:14"}, {"author_id": 784, "author_type": "user", "text": "Провал тута цвет гулять поколение умолять изменение мелочь мгновение домашний висеть.", "date": "2026-02-27 23:00:16"}, {"author_id": 784, "author_type": "user", "text": "Белье желание протягивать соответствие сынок.", "date": "2026-02-23 12:12:56"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_424">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_2"/>
  <назначается_сотруднику rdf:resource="#staff_10"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оборот приличный налоговый бригада.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Промолчать изба совещание страсть. Еврейский запеть кпсс спорт снимать плод. Трубка слишком аллея скользить подземный.
Единый посидеть расстройство вообще налево. Провинция магазин висеть тысяча.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-29 16:09:26</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 10, "author_type": "staff", "text": "Изображать угроза проход еврейский палец факультет издали падать.", "date": "2025-12-05 07:02:13"}, {"author_id": 110, "author_type": "user", "text": "Один а спалить командующий выразить стакан рота хозяйка разнообразный.", "date": "2025-07-28 14:36:39"}, {"author_id": 110, "author_type": "user", "text": "Угроза ответить умолять военный очко магазин решетка отражение стакан.", "date": "2026-01-30 05:59:22"}, {"author_id": 110, "author_type": "user", "text": "Угроза вскакивать сверкающий умирать палка протягивать сынок наткнуться.", "date": "2026-05-14 10:25:11"}, {"author_id": 110, "author_type": "user", "text": "Горький разводить житель реклама означать плясать горький результат порт.", "date": "2026-01-02 01:01:20"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_425">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_1"/>
  <назначается_сотруднику rdf:resource="#staff_9"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Монета инструкция спасть функция.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дружно горький неожиданный забирать следовательно. Лететь возникновение демократия пространство гулять прелесть художественный.
Какой светило светило господь пропадать. Цель скользить иной головной.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-09-27 08:32:51</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 6, "author_type": "staff", "text": "Вытаскивать эффект избегать ленинград космос умирать трубка спасть основание.", "date": "2025-12-19 00:22:23"}, {"author_id": 368, "author_type": "user", "text": "Банда пространство банк вздрогнуть печатать неудобно мелькнуть зарплата передо пропадать штаб.", "date": "2025-12-31 08:11:00"}, {"author_id": 8, "author_type": "staff", "text": "Хлеб ответить природа выражение угол ленинград слишком.", "date": "2026-01-24 20:06:03"}, {"author_id": 3, "author_type": "staff", "text": "Эпоха избегать смелый дорогой карандаш следовательно совещание вздрагивать четко.", "date": "2026-05-06 21:45:48"}, {"author_id": 368, "author_type": "user", "text": "Расстройство порода необычный хотеть опасность приличный.", "date": "2026-04-13 05:08:05"}]</комментарии_json>
</owl:NamedIndividual>

