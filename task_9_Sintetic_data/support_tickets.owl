  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 618, "author_type": "user", "text": "Граница природа естественный находить танцевать заплакать сохранять куча нервно лететь.", "date": "2026-01-17 13:58:42"}, {"author_id": 3, "author_type": "staff", "text": "Сутки пасть факультет эффект функция беспомощный дыхание мелькнуть материя анализ.", "date": "2026-03-22 08:50:24"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1876">
