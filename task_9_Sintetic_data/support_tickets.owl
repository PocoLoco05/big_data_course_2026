<owl:NamedIndividual rdf:about="#ticket_3423">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_2"/>
  <назначается_сотруднику rdf:resource="#staff_6"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Термин войти совет смертельный миг.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Чем плавно что соответствие разводить сутки дыхание помолчать. Спичка коричневый прежний домашний невыносимый. Призыв дружно аллея тяжелый торговля какой палка.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-18 17:31:44</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 4, "author_type": "staff", "text": "Поколение столетие настать дорогой еврейский.", "date": "2025-08-09 02:37:59"}, {"author_id": 937, "author_type": "user", "text": "Миг слишком сынок сходить спешить при фонарик приятель понятный карман.", "date": "2026-05-07 12:38:58"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3424">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_10"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поговорить рис дыхание.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Космос бабочка народ советовать выраженный один наткнуться.
Каюта правление зачем вряд пропадать неправда. Сомнительный пастух вообще похороны выраженный постоянный.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-02-28 21:44:30</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 3, "author_type": "staff", "text": "Сынок вряд заявление хотеть мусор сохранять мягкий нож.", "date": "2026-03-11 11:06:56"}, {"author_id": 71, "author_type": "user", "text": "Металл банк приятель миллиард войти экзамен правильный.", "date": "2025-07-19 08:49:25"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3425">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_4"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Провал пропасть засунуть.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Способ смелый поговорить куча металл. Мотоцикл деньги еврейский уронить невыносимый. За цвет прощение механический бочок банда выраженный.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-06-13 06:13:21</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 8, "author_type": "staff", "text": "Дошлый кольцо передо покидать близко сопровождаться.", "date": "2026-02-02 07:32:50"}, {"author_id": 7, "author_type": "staff", "text": "Уронить головка пробовать господь при командир.", "date": "2025-10-19 03:00:48"}, {"author_id": 634, "author_type": "user", "text": "Девка мальчишка палец иной жить назначить.", "date": "2025-12-09 02:33:49"}, {"author_id": 4, "author_type": "staff", "text": "Жидкий ночь роскошный даль грудь полностью мелькнуть инструкция видимо выбирать постоянный.", "date": "2025-09-11 03:07:17"}]</комментарии_json>
</owl:NamedIndividual>

