  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 846, "author_type": "user", "text": "Славный забирать невозможно засунуть достоинство сустав поздравлять господь.", "date": "2026-04-08 02:32:08"}, {"author_id": 4, "author_type": "staff", "text": "Вскакивать дремать более школьный спасть покидать.", "date": "2025-07-20 08:27:12"}, {"author_id": 846, "author_type": "user", "text": "Отражение школьный аж экзамен мягкий экзамен функция крутой сверкать.", "date": "2026-01-11 23:50:27"}, {"author_id": 846, "author_type": "user", "text": "Степь задержать правый хотеть нож.", "date": "2025-11-08 01:17:53"}, {"author_id": 10, "author_type": "staff", "text": "Научить командующий невыносимый через картинка помимо бригада господь.", "date": "2025-12-02 06:21:53"}]</комментарии_json>
</owl:NamedIndividual>

