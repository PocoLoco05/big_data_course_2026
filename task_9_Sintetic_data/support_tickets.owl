  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 261, "author_type": "user", "text": "Горький построить обида результат заявление доставать песня палец белье плод висеть.", "date": "2026-01-07 20:21:11"}, {"author_id": 9, "author_type": "staff", "text": "Вскакивать зато вздрогнуть запретить трясти бочок достоинство домашний редактор хлеб.", "date": "2026-03-27 04:45:30"}, {"author_id": 6, "author_type": "staff", "text": "Лапа нож деньги перебивать возникновение.", "date": "2026-04-01 09:00:39"}]</комментарии_json>
</owl:NamedIndividual>

