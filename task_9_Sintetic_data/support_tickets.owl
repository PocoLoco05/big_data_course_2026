  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 988, "author_type": "user", "text": "Функция засунуть ярко академик радость применяться.", "date": "2026-04-03 01:56:17"}, {"author_id": 2, "author_type": "staff", "text": "Роскошный исследование поздравлять недостаток приятель шлем легко плод неожиданный.", "date": "2025-07-22 15:49:02"}, {"author_id": 4, "author_type": "staff", "text": "Космос кпсс ученый домашний пол полностью обида нервно слишком полностью.", "date": "2026-02-16 02:21:46"}, {"author_id": 10, "author_type": "staff", "text": "Ярко крутой сходить цепочка страсть пасть лапа близко.", "date": "2026-01-14 10:51:27"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_4708">
