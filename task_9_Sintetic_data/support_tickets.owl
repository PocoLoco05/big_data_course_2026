  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 7, "author_type": "staff", "text": "Песня тревога грудь ленинград дьявол.", "date": "2025-11-07 16:06:51"}, {"author_id": 627, "author_type": "user", "text": "Оборот ленинград аж рассуждение спалить развернуться мягкий задрать зима бочок.", "date": "2025-11-11 18:36:35"}, {"author_id": 627, "author_type": "user", "text": "Поймать скрытый избегать провал падать ягода.", "date": "2026-04-03 03:36:20"}, {"author_id": 2, "author_type": "staff", "text": "Передо успокоиться падаль изба намерение материя заработать вряд роса.", "date": "2026-03-27 09:44:32"}]</комментарии_json>
</owl:NamedIndividual>

