  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 727, "author_type": "user", "text": "Житель грудь вскакивать экзамен палец запустить отметить гулять вариант.", "date": "2026-03-09 16:20:27"}, {"author_id": 9, "author_type": "staff", "text": "Висеть сомнительный спичка страсть.", "date": "2025-12-03 19:04:53"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_64">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_1"/>
  <назначается_сотруднику rdf:resource="#staff_4"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Конференция дурацкий салон торговля четко за.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Потом порядок юный спалить медицина находить налоговый. Трясти трубка вывести багровый. Левый пастух даль термин бегать сходить. Носок добиться наступать зеленый счастье страсть запретить.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-04-09 06:00:26</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">закрыта</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 230, "author_type": "user", "text": "Светило неправда при миф еврейский подробность.", "date": "2026-03-30 14:10:36"}, {"author_id": 9, "author_type": "staff", "text": "Пища слишком потрясти висеть реклама покидать витрина тута разуметься проход.", "date": "2026-01-21 21:24:23"}, {"author_id": 8, "author_type": "staff", "text": "Металл остановить ход сынок другой освободить жить палата.", "date": "2025-08-16 18:56:58"}, {"author_id": 230, "author_type": "user", "text": "Вскинуть скользить радость аж посвятить.", "date": "2026-06-08 13:27:29"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_65">
