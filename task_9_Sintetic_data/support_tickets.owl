  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 576, "author_type": "user", "text": "Совет один точно угодный выдержать строительство.", "date": "2025-12-21 13:13:53"}, {"author_id": 5, "author_type": "staff", "text": "Торговля лететь тюрьма висеть салон вздрогнуть устройство вряд столетие оборот.", "date": "2026-04-19 15:29:01"}, {"author_id": 6, "author_type": "staff", "text": "При теория бровь развернуться увеличиваться.", "date": "2025-10-23 11:07:33"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3579">
