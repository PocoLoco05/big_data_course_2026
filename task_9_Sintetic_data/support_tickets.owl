  <назначается_сотруднику rdf:resource="#staff_6"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Торопливый торопливый ход госпожа.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Руководитель выбирать труп развернуться очко. Бочок неожиданный важный бок смеяться. Мягкий художественный прелесть манера дошлый падаль.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-04-03 22:53:05</дата_создания>
