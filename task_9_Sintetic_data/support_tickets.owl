</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_427">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_2"/>
  <назначается_сотруднику rdf:resource="#staff_8"/>
