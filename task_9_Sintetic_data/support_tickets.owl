  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 7, "author_type": "staff", "text": "Вариант радость изредка шлем юный школьный плод невозможно.", "date": "2026-04-04 20:15:59"}, {"author_id": 5, "author_type": "staff", "text": "Войти деловой ленинград назначить граница.", "date": "2026-05-12 13:17:47"}, {"author_id": 889, "author_type": "user", "text": "Природа мгновение основание эпоха результат терапия соответствие изучить.", "date": "2025-08-25 00:30:58"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1132">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_1"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Палка полностью дьявол прошептать функция.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Холодно порт запустить костер. Дружно аж багровый очередной. Печатать головка второй казнь цель природа посвятить ночь.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-05-25 00:39:19</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 5, "author_type": "staff", "text": "Спорт ныне упорно коллектив другой.", "date": "2026-02-16 09:28:46"}, {"author_id": 556, "author_type": "user", "text": "Невозможно художественный прошептать очередной полностью термин полюбить.", "date": "2026-06-15 01:36:47"}, {"author_id": 556, "author_type": "user", "text": "Конструкция правый остановить казнь что решение.", "date": "2025-12-02 19:47:06"}, {"author_id": 1, "author_type": "staff", "text": "Издали сверкать костер кпсс табак жить сомнительный плясать витрина песенка.", "date": "2026-03-25 15:09:49"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1133">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_4"/>
  <назначается_сотруднику rdf:resource="#staff_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бегать цель что идея редактор.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дружно роскошный редактор поезд да растеряться. Песня порядок салон изменение дрогнуть пробовать полюбить порода. Выдержать еврейский вчера рассуждение угодный опасность выкинуть.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-08-19 21:43:22</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 545, "author_type": "user", "text": "Художественный уничтожение неожиданно пропаганда подробность дрогнуть изменение заработать еврейский хозяйка.", "date": "2026-01-05 08:06:15"}, {"author_id": 7, "author_type": "staff", "text": "Да девка порт голубчик демократия зачем художественный.", "date": "2025-11-20 01:30:17"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1134">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_10"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Конструкция решетка пересечь.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Присесть кидать зарплата порог эффект очутиться очередной. Чувство жидкий естественный инвалид слишком цель изучить отъезд. Полюбить нож народ кольцо.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-27 10:14:06</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 1, "author_type": "staff", "text": "Триста выдержать мелькнуть наступать экзамен сынок.", "date": "2025-12-23 16:46:35"}, {"author_id": 915, "author_type": "user", "text": "Школьный магазин спорт невыносимый госпожа тысяча изображать посвятить засунуть ленинград.", "date": "2026-06-02 16:18:05"}]</комментарии_json>
