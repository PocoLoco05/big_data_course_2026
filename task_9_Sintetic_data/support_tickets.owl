  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 8, "author_type": "staff", "text": "Крыса коллектив грустный тревога миф столетие горький появление собеседник желание.", "date": "2025-08-21 13:56:26"}, {"author_id": 2, "author_type": "staff", "text": "Бак передо дрогнуть торговля валюта оборот.", "date": "2026-06-23 17:37:06"}, {"author_id": 464, "author_type": "user", "text": "Инвалид смелый пространство плясать возможно вчера выдержать одиннадцать ломать.", "date": "2026-06-03 04:22:15"}, {"author_id": 2, "author_type": "staff", "text": "Изучить низкий район крутой избегать прощение поставить.", "date": "2025-10-23 20:31:03"}, {"author_id": 464, "author_type": "user", "text": "Холодно услать рассуждение сынок зарплата жестокий господь.", "date": "2026-01-30 23:54:46"}]</комментарии_json>
</owl:NamedIndividual>

