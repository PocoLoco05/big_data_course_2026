  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 2, "author_type": "staff", "text": "Ход более полюбить господь кузнец хозяйка художественный князь вообще.", "date": "2026-01-04 16:25:29"}, {"author_id": 125, "author_type": "user", "text": "Порт аллея блин рот угол более академик.", "date": "2025-12-17 01:32:56"}, {"author_id": 6, "author_type": "staff", "text": "Металл засунуть конференция салон пламя столетие свежий.", "date": "2025-08-13 23:37:11"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2647">
  <rdf:type rdf:resource="#Заявка"/>
