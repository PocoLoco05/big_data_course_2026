</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3724">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_4"/>
  <назначается_сотруднику rdf:resource="#staff_7"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Головной затянуться спорт ход зато.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бетонный лететь валюта металл тяжелый. Монета домашний ответить издали бровь. Беспомощный домашний очко важный исследование. Еврейский ботинок страсть заплакать.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-19 08:41:09</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">критический</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 8, "author_type": "staff", "text": "Печатать нервно танцевать светило равнодушный лиловый нервно совет.", "date": "2025-11-21 23:32:09"}, {"author_id": 4, "author_type": "staff", "text": "Жить разводить кузнец построить идея факультет бок жить.", "date": "2026-05-22 13:01:03"}, {"author_id": 6, "author_type": "staff", "text": "Девка неправда заявление засунуть бак конструкция.", "date": "2025-07-05 12:24:46"}, {"author_id": 7, "author_type": "staff", "text": "Невыносимый смертельный провинция счастье сомнительный очко ныне около.", "date": "2026-05-11 05:52:48"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3725">
  <rdf:type rdf:resource="#Заявка"/>
