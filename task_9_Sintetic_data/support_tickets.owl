  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 3, "author_type": "staff", "text": "Выражение падать анализ казнь темнеть юный хотеть бровь миф появление.", "date": "2026-04-28 14:07:46"}, {"author_id": 4, "author_type": "staff", "text": "Один видимо спасть инфекция непривычный июнь смеяться.", "date": "2026-03-16 11:13:32"}, {"author_id": 3, "author_type": "staff", "text": "Понятный мусор конструкция покидать ложиться юный.", "date": "2025-12-23 04:11:37"}, {"author_id": 760, "author_type": "user", "text": "Вывести зато спорт достоинство отражение пол висеть прошептать природа редактор проход.", "date": "2025-09-15 06:29:08"}]</комментарии_json>
</owl:NamedIndividual>

