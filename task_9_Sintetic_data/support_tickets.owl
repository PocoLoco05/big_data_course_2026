  <относится_к_категории rdf:resource="#category_4"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Крыса песня банк провинция.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Факультет район желание полевой карман. Карандаш еврейский нож волк прежний полностью ребятишки. Магазин цель грудь вскинуть юный полностью.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-06-06 04:26:52</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">новая</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 61, "author_type": "user", "text": "Инфекция интеллектуальный слишком манера штаб.", "date": "2025-10-07 07:44:35"}, {"author_id": 61, "author_type": "user", "text": "Налоговый неожиданно школьный сустав мелочь коллектив палка.", "date": "2026-06-19 11:08:35"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_4703">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Интеллектуальный ложиться потянуться правильный.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Грудь беспомощный перебивать сверкающий процесс умолять точно.
Беспомощный появление даль. Построить пасть вывести прежний. Вытаскивать уничтожение команда миг исполнять одиннадцать миллиард.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-08-04 02:51:48</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Правильный научить госпожа расстегнуть выгнать плясать.", "date": "2025-08-21 23:24:25"}, {"author_id": 1, "author_type": "staff", "text": "Сынок штаб счастье сынок июнь запустить место инструкция.", "date": "2026-04-16 09:51:42"}, {"author_id": 7, "author_type": "staff", "text": "Нервно прошептать степь горький поздравлять.", "date": "2025-12-21 02:49:28"}]</комментарии_json>
</owl:NamedIndividual>

