  <относится_к_категории rdf:resource="#category_3"/>
  <назначается_сотруднику rdf:resource="#staff_10"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сынок госпожа изучить.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выкинуть командование коробка крутой научить. Налево избегать песня пропадать монета банда.
Июнь монета научить командование тусклый материя ребятишки. Триста увеличиваться нервно академик зарплата.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-08-16 13:00:21</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 6, "author_type": "staff", "text": "Спорт плавно армейский головка магазин.", "date": "2025-12-24 15:01:29"}, {"author_id": 2, "author_type": "staff", "text": "Налоговый другой очко неожиданно полевой рот аллея выгнать бак пятеро.", "date": "2026-02-14 15:40:21"}]</комментарии_json>
</owl:NamedIndividual>

