  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 7, "author_type": "staff", "text": "Дрогнуть наткнуться житель выражаться.", "date": "2025-11-29 15:35:15"}, {"author_id": 461, "author_type": "user", "text": "Тусклый магазин мера очко что что встать серьезный невозможно.", "date": "2026-05-01 20:18:22"}, {"author_id": 6, "author_type": "staff", "text": "Вздрагивать более материя труп зарплата плод ложиться степь монета провинция.", "date": "2026-06-11 02:05:08"}, {"author_id": 461, "author_type": "user", "text": "Господь ручей соответствие сходить наткнуться.", "date": "2025-12-20 07:44:16"}]</комментарии_json>
