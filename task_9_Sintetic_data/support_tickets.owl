  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 4, "author_type": "staff", "text": "Избегать ярко приятель человечек табак выражаться печатать.", "date": "2025-10-19 10:52:55"}, {"author_id": 673, "author_type": "user", "text": "Солнце социалистический тусклый банк карандаш уничтожение табак жидкий карман.", "date": "2025-09-22 14:34:39"}, {"author_id": 673, "author_type": "user", "text": "Командование трубка применяться витрина порт еврейский мучительно жидкий пробовать настать.", "date": "2025-11-10 20:52:45"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3263">
