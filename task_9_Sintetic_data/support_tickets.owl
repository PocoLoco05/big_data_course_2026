  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 784, "author_type": "user", "text": "Аж командующий очередной крыса совет потрясти крыса.", "date": "2026-05-06 21:41:46"}, {"author_id": 10, "author_type": "staff", "text": "Актриса сопровождаться неудобно ставить.", "date": "2026-03-02 17:56:33"}, {"author_id": 1, "author_type": "staff", "text": "Что тяжелый счастье указанный точно.", "date": "2026-02-25 00:21:33"}, {"author_id": 784, "author_type": "user", "text": "Бровь прощение командование ботинок набор.", "date": "2026-06-13 14:54:11"}, {"author_id": 784, "author_type": "user", "text": "Спичка невыносимый роса близко бак расстегнуть стакан мгновение добиться.", "date": "2025-11-22 23:44:23"}]</комментарии_json>
</owl:NamedIndividual>

