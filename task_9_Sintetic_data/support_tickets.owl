  <назначается_сотруднику rdf:resource="#staff_6"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Горький растеряться сравнение приятель.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прошептать зеленый вперед издали ломать основание. Построить настать анализ столетие. Смеяться тута степь идея пропасть висеть. Триста около лиловый порода.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-03-04 07:00:56</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 5, "author_type": "staff", "text": "Аж рабочий тесно следовательно радость.", "date": "2026-03-23 05:46:07"}, {"author_id": 3, "author_type": "staff", "text": "Приятель поколение покидать посвятить манера дрогнуть иной.", "date": "2025-12-07 16:44:40"}, {"author_id": 8, "author_type": "staff", "text": "Расстройство слишком устройство дремать наступать свежий кузнец пересечь решение.", "date": "2025-11-03 23:42:15"}, {"author_id": 5, "author_type": "staff", "text": "Трясти потом постоянный выдержать пропадать пропаганда.", "date": "2026-02-27 07:11:01"}, {"author_id": 152, "author_type": "user", "text": "Задержать дружно соответствие трясти функция изображать магазин исследование выражаться передо.", "date": "2025-10-18 20:24:18"}]</комментарии_json>
</owl:NamedIndividual>

