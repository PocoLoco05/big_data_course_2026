  <назначается_сотруднику rdf:resource="#staff_1"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Посвятить висеть потрясти монета.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пол командир правление мрачно. Порядок коллектив свежий ночь цвет совещание смелый. Сустав спасть ярко находить.
Инвалид недостаток крыса. Очко район дремать серьезный экзамен протягивать потянуться.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-03-31 00:39:01</дата_создания>
