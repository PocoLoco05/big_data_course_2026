  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 575, "author_type": "user", "text": "Ставить цель грустный жестокий изредка костер очутиться наслаждение.", "date": "2025-11-09 20:19:38"}, {"author_id": 10, "author_type": "staff", "text": "Тюрьма магазин руководитель трясти.", "date": "2026-06-19 06:41:04"}, {"author_id": 575, "author_type": "user", "text": "Потянуться ведь интернет призыв доставать страсть горький уронить потом одиннадцать висеть.", "date": "2026-01-02 07:43:33"}, {"author_id": 575, "author_type": "user", "text": "Каюта пропасть построить карман слишком порт.", "date": "2025-10-06 19:35:30"}, {"author_id": 6, "author_type": "staff", "text": "Ложиться недостаток миф слать возбуждение сравнение чувство реклама.", "date": "2026-03-03 21:47:42"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_536">
