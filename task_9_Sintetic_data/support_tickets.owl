  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Нервно вскакивать приятель добиться вздрагивать добиться призыв.", "date": "2026-01-13 13:26:07"}, {"author_id": 949, "author_type": "user", "text": "Кожа указанный житель умирать отражение подробность затянуться остановить.", "date": "2025-07-01 02:22:31"}, {"author_id": 3, "author_type": "staff", "text": "Помолчать угол дурацкий песня иной беспомощный потянуться возбуждение анализ степь тесно.", "date": "2025-10-07 13:29:49"}]</комментарии_json>
</owl:NamedIndividual>

