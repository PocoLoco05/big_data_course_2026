  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 924, "author_type": "user", "text": "Бригада мотоцикл бочок приятель иной мера легко сомнительный.", "date": "2025-12-31 16:54:01"}, {"author_id": 924, "author_type": "user", "text": "Чем единый висеть невыносимый премьера о результат вариант карман вытаскивать.", "date": "2025-08-13 22:11:05"}, {"author_id": 8, "author_type": "staff", "text": "Спичка июнь процесс горький присесть четыре девка болото.", "date": "2026-05-31 16:34:44"}, {"author_id": 924, "author_type": "user", "text": "Аллея боец труп выразить правильный народ мотоцикл табак наткнуться.", "date": "2026-05-13 17:04:37"}, {"author_id": 924, "author_type": "user", "text": "Угроза хозяйка светило термин провал космос.", "date": "2026-02-17 23:10:18"}]</комментарии_json>
</owl:NamedIndividual>

