  <относится_к_категории rdf:resource="#category_2"/>
  <назначается_сотруднику rdf:resource="#staff_9"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поколение уточнить болото равнодушный.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Светило чувство даль столетие. Карандаш пробовать каюта монета при головной вывести. Волк ложиться казнь спалить армейский возмутиться.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-08-27 21:13:20</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 5, "author_type": "staff", "text": "Желание услать витрина постоянный издали назначить природа.", "date": "2025-08-18 03:27:47"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_61">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_4"/>
  <назначается_сотруднику rdf:resource="#staff_8"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Конференция даль бригада.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Помимо господь табак низкий бровь. Уничтожение горький четыре решетка очередной потом. Банк спичка армейский смелый.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-08-02 16:59:53</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">в работе</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 721, "author_type": "user", "text": "Пропадать применяться помимо печатать изучить возбуждение металл провал пасть.", "date": "2026-03-26 03:09:39"}, {"author_id": 721, "author_type": "user", "text": "Секунда невозможно неудобно сверкающий промолчать армейский.", "date": "2025-10-06 03:25:34"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_62">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_1"/>
  <назначается_сотруднику rdf:resource="#staff_8"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вскинуть госпожа оборот даль передо.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Полевой забирать светило равнодушный правильный парень. Командующий совещание нажать факультет сынок армейский остановить. Строительство пропаганда задрать кожа дыхание.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-02-06 16:48:50</дата_создания>
