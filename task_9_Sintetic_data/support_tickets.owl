  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 16, "author_type": "user", "text": "Способ очутиться смеяться понятный вскакивать плясать ныне кпсс плод рай.", "date": "2026-01-29 09:13:56"}, {"author_id": 5, "author_type": "staff", "text": "Передо сынок запустить пол пробовать видимо недостаток очко художественный.", "date": "2025-10-12 19:07:33"}, {"author_id": 8, "author_type": "staff", "text": "Ставить при около дошлый смелый вскакивать смертельный пастух сопровождаться.", "date": "2026-02-09 09:18:26"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3264">
