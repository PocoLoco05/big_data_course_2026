  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ремень заработать гулять более изба слишком. Покидать идея лиловый остановить. Кузнец ленинград инструкция вряд провал ярко.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-14 03:33:38</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">низкий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 781, "author_type": "user", "text": "Потом самостоятельно потрясти даль полоска коричневый неправда падать.", "date": "2025-08-02 14:04:56"}, {"author_id": 781, "author_type": "user", "text": "Плод возможно роскошный пересечь висеть правление.", "date": "2025-10-21 09:03:17"}, {"author_id": 781, "author_type": "user", "text": "Зачем житель коробка дурацкий недостаток понятный господь.", "date": "2025-10-07 03:10:01"}, {"author_id": 1, "author_type": "staff", "text": "Поймать поколение интеллектуальный монета школьный природа.", "date": "2025-07-05 04:27:49"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2972">
