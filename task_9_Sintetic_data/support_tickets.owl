  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 526, "author_type": "user", "text": "Сравнение оборот поставить постоянный находить заведение ярко самостоятельно господь прелесть.", "date": "2025-11-08 08:30:54"}, {"author_id": 3, "author_type": "staff", "text": "Холодно умолять оборот рис тысяча юный роса правление художественный плод спешить.", "date": "2025-06-25 09:55:54"}]</комментарии_json>
</owl:NamedIndividual>

