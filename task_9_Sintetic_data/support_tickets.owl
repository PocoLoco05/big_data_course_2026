  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 4, "author_type": "staff", "text": "Рис коллектив академик постоянный товар.", "date": "2025-09-22 05:38:40"}, {"author_id": 7, "author_type": "staff", "text": "Нервно функция дыхание реклама место прежде поговорить.", "date": "2025-12-09 10:16:21"}, {"author_id": 63, "author_type": "user", "text": "Разнообразный госпожа бок страсть сынок прелесть горький бочок дремать советовать.", "date": "2026-02-21 10:02:48"}, {"author_id": 63, "author_type": "user", "text": "Монета сынок запретить неудобно кузнец провинция означать недостаток художественный.", "date": "2026-05-27 15:36:57"}, {"author_id": 63, "author_type": "user", "text": "Сопровождаться смеяться желание около освобождение проход место оставить.", "date": "2025-08-01 08:40:30"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3723">
  <rdf:type rdf:resource="#Заявка"/>
