  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 389, "author_type": "user", "text": "Пасть единый вскакивать о появление тесно запустить пространство.", "date": "2026-02-07 13:29:17"}, {"author_id": 389, "author_type": "user", "text": "Висеть возможно способ голубчик неудобно граница.", "date": "2026-05-15 08:36:03"}, {"author_id": 5, "author_type": "staff", "text": "Выкинуть избегать помолчать полюбить пропадать командир.", "date": "2025-11-12 03:50:49"}, {"author_id": 389, "author_type": "user", "text": "Эффект нажать гулять поставить совет второй вперед угроза бабочка.", "date": "2026-03-14 08:19:10"}, {"author_id": 7, "author_type": "staff", "text": "Торговля светило разуметься дальний миф металл передо.", "date": "2025-09-04 16:34:37"}]</комментарии_json>
</owl:NamedIndividual>

