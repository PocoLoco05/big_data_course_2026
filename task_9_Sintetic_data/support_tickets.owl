<owl:NamedIndividual rdf:about="#ticket_2996">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_1"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Способ конференция поставить.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лиловый интернет пропаганда команда. Угол порядок роскошный армейский. Приличный способ построить результат построить витрина.</описание>
