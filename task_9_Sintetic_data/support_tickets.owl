  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Похороны спорт кожа пропасть желание спасть провал госпожа заявление дальний ремень.", "date": "2025-08-05 08:27:54"}, {"author_id": 10, "author_type": "staff", "text": "Невыносимый применяться мелькнуть казнь светило командир место приятель потом проход вряд.", "date": "2026-02-06 07:50:21"}, {"author_id": 8, "author_type": "staff", "text": "Встать результат витрина мусор эффект конструкция пламя дурацкий.", "date": "2026-05-21 03:31:34"}, {"author_id": 2, "author_type": "staff", "text": "Коробка вскакивать промолчать сверкающий место спалить видимо.", "date": "2026-04-11 01:01:26"}, {"author_id": 980, "author_type": "user", "text": "Редактор бетонный основание бригада жестокий.", "date": "2026-06-13 08:50:36"}]</комментарии_json>
</owl:NamedIndividual>

