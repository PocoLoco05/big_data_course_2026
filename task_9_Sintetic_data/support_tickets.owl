  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 589, "author_type": "user", "text": "Назначить командир мотоцикл интернет пропасть означать парень юный.", "date": "2026-01-08 16:31:04"}, {"author_id": 589, "author_type": "user", "text": "Мучительно юный прежде около назначить что выгнать фонарик решетка упорно.", "date": "2025-06-26 22:31:07"}, {"author_id": 589, "author_type": "user", "text": "Засунуть выраженный темнеть спасть вообще тяжелый угроза палец новый.", "date": "2026-01-20 14:52:18"}, {"author_id": 589, "author_type": "user", "text": "Мера что пастух постоянный отдел умирать.", "date": "2026-02-23 06:26:00"}, {"author_id": 9, "author_type": "staff", "text": "Рабочий грудь мусор пересечь мрачно устройство пламя.", "date": "2025-10-04 02:32:33"}]</комментарии_json>
</owl:NamedIndividual>

