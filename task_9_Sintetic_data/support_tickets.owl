  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 7, "author_type": "staff", "text": "Угол бок стакан бак палка вариант пища выраженный белье.", "date": "2025-12-13 22:29:19"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1125">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_2"/>
  <назначается_сотруднику rdf:resource="#staff_7"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Порог мелькнуть коммунизм слишком.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вперед прошептать наступать. Господь некоторый господь ярко хотеть лететь вскинуть идея. Палка лететь мера терапия академик командование порода. Зарплата более правый жидкий возможно.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-09-25 09:43:14</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 670, "author_type": "user", "text": "Июнь заявление некоторый хозяйка возникновение.", "date": "2026-04-25 11:15:08"}, {"author_id": 7, "author_type": "staff", "text": "Пастух упорно написать лапа встать пища видимо ставить недостаток ответить.", "date": "2025-11-22 11:42:16"}, {"author_id": 670, "author_type": "user", "text": "Число мелькнуть войти подземный важный остановить место.", "date": "2025-11-02 09:58:16"}, {"author_id": 670, "author_type": "user", "text": "Монета сынок сохранять запретить покидать протягивать светило.", "date": "2026-04-03 05:27:04"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1126">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_5"/>
  <назначается_сотруднику rdf:resource="#staff_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ученый желание ставить помимо спорт.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Упорно материя изредка идея. Кидать число расстегнуть развитый видимо подземный. Правильный спешить блин чем четко. Четко назначить падаль желание изображать цель упор.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-09-09 00:27:11</дата_создания>
