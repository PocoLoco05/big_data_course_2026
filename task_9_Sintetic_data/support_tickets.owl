  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 7, "author_type": "staff", "text": "Кпсс социалистический товар желание выкинуть.", "date": "2025-09-03 07:18:38"}, {"author_id": 5, "author_type": "staff", "text": "Легко понятный темнеть передо госпожа уронить домашний художественный.", "date": "2026-04-14 18:38:55"}, {"author_id": 7, "author_type": "staff", "text": "Смелый миф через бабочка командование провал темнеть серьезный сутки.", "date": "2026-03-14 23:04:11"}, {"author_id": 943, "author_type": "user", "text": "Правый функция головка вариант привлекать сомнительный аж.", "date": "2025-08-20 04:46:30"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3578">
  <rdf:type rdf:resource="#Заявка"/>
