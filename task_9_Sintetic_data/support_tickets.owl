</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1884">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_5"/>
  <назначается_сотруднику rdf:resource="#staff_10"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Передо второй снимать банда разводить дурацкий.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Термин тяжелый полевой. Плод зеленый монета о дружно процесс.
Что юный присесть лететь угол. Освобождение легко еврейский.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-09-27 18:19:23</дата_создания>
