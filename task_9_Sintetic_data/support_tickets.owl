  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 151, "author_type": "user", "text": "Поставить рота ленинград направо монета лапа штаб ученый важный встать.", "date": "2026-04-14 21:45:02"}, {"author_id": 151, "author_type": "user", "text": "Райком полоска способ каюта потянуться пятеро упор лететь.", "date": "2025-10-28 09:54:56"}, {"author_id": 151, "author_type": "user", "text": "Поздравлять спичка возбуждение тусклый князь мелькнуть потянуться покидать.", "date": "2025-10-06 23:58:22"}, {"author_id": 151, "author_type": "user", "text": "Тысяча актриса ночь потом торговля мелькнуть развернуться приятель.", "date": "2025-09-02 06:44:49"}, {"author_id": 3, "author_type": "staff", "text": "Ночь вряд мучительно желание госпожа решение равнодушный четко механический.", "date": "2026-01-16 13:49:59"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3255">
