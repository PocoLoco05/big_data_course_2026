  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 1, "author_type": "staff", "text": "Пятеро рота место порог конференция непривычный мелочь.", "date": "2026-02-10 09:41:08"}, {"author_id": 9, "author_type": "staff", "text": "Житель ягода провал покидать совещание разуметься мягкий привлекать дрогнуть зарплата.", "date": "2026-02-12 16:58:59"}, {"author_id": 8, "author_type": "staff", "text": "Белье близко присесть парень смертельный.", "date": "2025-11-07 07:51:15"}, {"author_id": 6, "author_type": "staff", "text": "Пропаганда пища поколение тревога развитый пол.", "date": "2025-08-09 00:23:06"}]</комментарии_json>
</owl:NamedIndividual>

