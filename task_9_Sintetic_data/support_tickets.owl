  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Ленинград доставать самостоятельно правление картинка карандаш строительство.", "date": "2025-09-06 08:53:48"}, {"author_id": 488, "author_type": "user", "text": "Сохранять неправда через посвятить зачем задрать.", "date": "2025-08-19 21:21:40"}, {"author_id": 7, "author_type": "staff", "text": "Неправда инвалид витрина командующий поймать.", "date": "2025-08-29 13:32:30"}, {"author_id": 488, "author_type": "user", "text": "Чем находить место головной ярко непривычный.", "date": "2026-05-15 12:27:23"}, {"author_id": 488, "author_type": "user", "text": "Ход потянуться парень парень поздравлять второй крутой теория тысяча.", "date": "2025-11-16 15:57:52"}]</комментарии_json>
</owl:NamedIndividual>

