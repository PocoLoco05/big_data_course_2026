  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 4, "author_type": "staff", "text": "Адвокат адвокат близко сопровождаться настать дьявол невозможно премьера провинция бригада сбросить.", "date": "2025-06-27 21:12:27"}, {"author_id": 2, "author_type": "staff", "text": "Что оборот монета сынок.", "date": "2026-02-03 04:25:15"}, {"author_id": 85, "author_type": "user", "text": "Ботинок человечек витрина интернет темнеть ставить армейский.", "date": "2026-05-01 05:07:19"}, {"author_id": 85, "author_type": "user", "text": "Лапа спешить командующий витрина вперед.", "date": "2026-02-13 14:30:30"}]</комментарии_json>
