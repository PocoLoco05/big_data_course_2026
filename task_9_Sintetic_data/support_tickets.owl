  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 656, "author_type": "user", "text": "Палец тяжелый рабочий разнообразный холодно плод пробовать банда.", "date": "2025-08-05 07:39:33"}, {"author_id": 656, "author_type": "user", "text": "Другой развитый провал передо головной бок уничтожение слать прошептать.", "date": "2026-03-18 01:18:36"}, {"author_id": 1, "author_type": "staff", "text": "Дальний упорно дорогой вздрогнуть монета спалить процесс порода вывести военный.", "date": "2025-10-08 08:27:23"}, {"author_id": 656, "author_type": "user", "text": "Правильный степь плясать сверкающий оставить.", "date": "2025-12-11 12:18:18"}, {"author_id": 5, "author_type": "staff", "text": "Сравнение наткнуться намерение неправда прелесть настать.", "date": "2026-06-21 15:08:47"}]</комментарии_json>
</owl:NamedIndividual>

