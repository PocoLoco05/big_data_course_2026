  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Мелочь зеленый левый остановить основание костер анализ дрогнуть школьный.", "date": "2025-09-30 14:05:05"}, {"author_id": 569, "author_type": "user", "text": "Уничтожение расстройство очередной анализ тесно.", "date": "2025-08-12 01:46:37"}, {"author_id": 6, "author_type": "staff", "text": "Бетонный подземный отражение сынок монета серьезный пересечь сынок.", "date": "2025-08-30 08:16:37"}, {"author_id": 569, "author_type": "user", "text": "Потом аж сходить песня мучительно заведение.", "date": "2025-09-06 02:39:00"}, {"author_id": 4, "author_type": "staff", "text": "Бабочка фонарик успокоиться пропадать одиннадцать каюта пропадать каюта падать.", "date": "2025-09-04 22:16:35"}]</комментарии_json>
</owl:NamedIndividual>

