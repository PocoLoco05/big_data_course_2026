  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 168, "author_type": "user", "text": "Да кожа постоянный новый передо мусор трясти вывести спорт факультет.", "date": "2025-09-06 19:10:40"}, {"author_id": 8, "author_type": "staff", "text": "Заработать приятель горький другой правление жидкий картинка виднеться недостаток.", "date": "2026-06-05 11:18:29"}, {"author_id": 168, "author_type": "user", "text": "Поставить тусклый дьявол миг головка изучить протягивать заложить.", "date": "2025-12-30 00:14:20"}, {"author_id": 7, "author_type": "staff", "text": "Прошептать точно возмутиться порт девка.", "date": "2025-11-20 14:57:59"}]</комментарии_json>
</owl:NamedIndividual>

