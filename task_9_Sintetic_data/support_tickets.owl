  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 2, "author_type": "staff", "text": "Основание мгновение изменение цвет граница протягивать поставить палец деньги выраженный.", "date": "2025-06-25 11:57:47"}, {"author_id": 350, "author_type": "user", "text": "Холодно руководитель сутки дружно актриса.", "date": "2025-08-21 09:31:07"}, {"author_id": 350, "author_type": "user", "text": "Невыносимый забирать скрытый правильный ленинград витрина наткнуться эффект.", "date": "2025-08-17 16:34:55"}, {"author_id": 3, "author_type": "staff", "text": "Отметить написать слишком невозможно.", "date": "2026-03-09 20:20:10"}, {"author_id": 2, "author_type": "staff", "text": "Развитый привлекать уронить неправда обида граница поймать равнодушный серьезный.", "date": "2026-01-18 18:04:14"}]</комментарии_json>
</owl:NamedIndividual>

