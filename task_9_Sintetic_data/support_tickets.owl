</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3430">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_5"/>
  <назначается_сотруднику rdf:resource="#staff_3"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Покидать ночь отъезд грустный увеличиваться выражение.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">О парень командование палец болото трубка. Юный за витрина зато сходить конференция инфекция. Тысяча изучить носок расстройство.
Набор провинция господь рис. Дурацкий славный смертельный медицина.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-07-04 21:28:47</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">средний</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 916, "author_type": "user", "text": "Анализ функция дыхание скользить бок направо солнце смертельный выразить мимо.", "date": "2025-12-06 18:01:56"}, {"author_id": 8, "author_type": "staff", "text": "Слишком что умолять самостоятельно близко написать.", "date": "2026-03-02 21:16:32"}, {"author_id": 4, "author_type": "staff", "text": "Задрать стакан граница поздравлять прежний лиловый оборот полевой.", "date": "2026-06-15 02:16:47"}, {"author_id": 9, "author_type": "staff", "text": "Скрытый юный тревога июнь отъезд кожа мусор жить плод миг.", "date": "2025-08-30 15:06:11"}, {"author_id": 916, "author_type": "user", "text": "Обида девка решетка через художественный неправда спичка аж проход.", "date": "2026-05-25 14:34:01"}]</комментарии_json>
</owl:NamedIndividual>

