</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_4706">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_4"/>
  <назначается_сотруднику rdf:resource="#staff_2"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кпсс демократия носок.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Славный редактор применяться боец пробовать домашний пересечь висеть. Поговорить сутки подземный развитый услать головка дорогой пространство. Плясать радость палата эффект поговорить около точно.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-05-29 14:46:09</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 954, "author_type": "user", "text": "Рассуждение полевой видимо постоянный желание.", "date": "2025-06-26 14:53:20"}, {"author_id": 2, "author_type": "staff", "text": "Беспомощный дошлый сомнительный услать тяжелый тысяча налево очередной горький.", "date": "2026-05-20 11:13:22"}, {"author_id": 954, "author_type": "user", "text": "Цвет посвятить райком результат актриса что блин художественный пересечь термин.", "date": "2025-12-25 18:05:05"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_4707">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_3"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Направо теория наслаждение промолчать деньги руководитель.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ручей армейский дружно снимать потом сомнительный избегать. Радость прелесть гулять пробовать отражение левый уронить. Правильный спорт рис мрачно спалить обида поговорить.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-06-09 18:58:22</дата_создания>
