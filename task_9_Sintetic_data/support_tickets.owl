  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 79, "author_type": "user", "text": "Мимо ложиться услать рассуждение солнце школьный вариант.", "date": "2026-02-20 16:38:32"}, {"author_id": 79, "author_type": "user", "text": "Вскинуть развернуться потянуться грустный дыхание зарплата приятель.", "date": "2025-09-04 18:41:57"}, {"author_id": 10, "author_type": "staff", "text": "Рота кольцо услать жидкий художественный правление пересечь витрина поколение зеленый.", "date": "2025-08-31 22:01:31"}, {"author_id": 79, "author_type": "user", "text": "Холодно район возмутиться падать команда налево болото место.", "date": "2025-08-09 19:47:21"}, {"author_id": 79, "author_type": "user", "text": "Эпоха выбирать горький научить.", "date": "2026-04-17 22:06:01"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_2642">
