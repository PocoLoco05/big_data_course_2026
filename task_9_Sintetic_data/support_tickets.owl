  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 76, "author_type": "user", "text": "Торопливый ломать чем угроза пасть цвет дыхание отдел.", "date": "2025-08-16 13:43:21"}, {"author_id": 10, "author_type": "staff", "text": "Провал засунуть рот стакан солнце.", "date": "2026-02-13 15:55:58"}, {"author_id": 1, "author_type": "staff", "text": "Число вывести эпоха сынок второй ребятишки.", "date": "2025-09-01 20:16:12"}, {"author_id": 3, "author_type": "staff", "text": "Спасть фонарик анализ прелесть сохранять отражение миф жестокий.", "date": "2026-01-04 11:19:31"}, {"author_id": 3, "author_type": "staff", "text": "Граница рис единый уничтожение грудь отъезд князь очко вперед бабочка.", "date": "2026-04-04 00:32:15"}]</комментарии_json>
</owl:NamedIndividual>

