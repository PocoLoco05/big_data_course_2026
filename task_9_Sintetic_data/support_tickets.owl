  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">новая</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 9, "author_type": "staff", "text": "Ведь миг эпоха порядок некоторый присесть юный.", "date": "2025-09-21 04:38:05"}, {"author_id": 97, "author_type": "user", "text": "Мгновение цепочка трясти выдержать бровь бригада прошептать.", "date": "2026-05-11 20:56:07"}, {"author_id": 5, "author_type": "staff", "text": "Школьный металл голубчик сустав карман тута.", "date": "2025-10-04 18:46:56"}]</комментарии_json>
</owl:NamedIndividual>

