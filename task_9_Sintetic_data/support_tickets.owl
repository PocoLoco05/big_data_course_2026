  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 435, "author_type": "user", "text": "Тесно идея еврейский порог еврейский тревога возможно основание проход смеяться.", "date": "2026-06-21 19:12:54"}, {"author_id": 10, "author_type": "staff", "text": "Видимо жить цепочка нож эпоха командующий.", "date": "2025-11-19 00:15:20"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1130">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_2"/>
  <назначается_сотруднику rdf:resource="#staff_8"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Инвалид пропадать монета.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цвет правление танцевать скрытый видимо. Недостаток сходить костер горький протягивать. Изучить правильный выражение выбирать тусклый дьявол пространство голубчик.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-03-02 08:10:08</дата_создания>
  <статус rdf:datatype="http://www.w3.org/2001/XMLSchema#string">решена</статус>
  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 265, "author_type": "user", "text": "Разнообразный расстройство мелочь райком основание кпсс слать зеленый рассуждение бок.", "date": "2026-01-05 17:06:22"}, {"author_id": 5, "author_type": "staff", "text": "Горький народ налоговый термин природа.", "date": "2026-01-04 13:58:33"}, {"author_id": 265, "author_type": "user", "text": "Очко академик плясать обида увеличиваться.", "date": "2026-02-24 15:54:39"}, {"author_id": 265, "author_type": "user", "text": "Белье висеть перебивать результат вздрагивать коллектив хлеб монета.", "date": "2025-12-30 19:38:53"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_1131">
  <rdf:type rdf:resource="#Заявка"/>
  <относится_к_категории rdf:resource="#category_4"/>
  <назначается_сотруднику rdf:resource="#staff_10"/>
  <тема rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Даль умирать вздрогнуть оборот рис упорно.</тема>
  <описание rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отдел сустав триста заявление. Проход полоска житель войти потом граница пропадать.
Оставить серьезный дорогой запретить перебивать развернуться металл. Тесно мягкий порт банк бак угроза.</описание>
  <дата_создания rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025-11-21 02:30:59</дата_создания>
