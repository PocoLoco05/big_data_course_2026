  <приоритет rdf:datatype="http://www.w3.org/2001/XMLSchema#string">высокий</приоритет>
  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 326, "author_type": "user", "text": "Пересечь сходить бочок ответить уничтожение грустный выбирать картинка.", "date": "2025-12-28 03:59:06"}, {"author_id": 326, "author_type": "user", "text": "Магазин палата коллектив отражение жить тревога редактор очко.", "date": "2026-04-12 08:03:10"}, {"author_id": 3, "author_type": "staff", "text": "Естественный карман инструкция самостоятельно передо дружно свежий.", "date": "2026-01-19 01:17:41"}, {"author_id": 3, "author_type": "staff", "text": "Сходить реклама четко материя вариант научить перебивать командование головка сустав возбуждение.", "date": "2025-09-22 15:58:10"}]</комментарии_json>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ticket_3035">
