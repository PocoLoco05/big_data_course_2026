  <комментарии_json rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"author_id": 8, "author_type": "staff", "text": "Промолчать угодный покидать слишком человечек.", "date": "2025-08-24 00:54:17"}, {"author_id": 9, "author_type": "staff", "text": "Ремень пища пересечь растеряться магазин рис серьезный.", "date": "2026-05-29 00:30:34"}, {"author_id": 19, "author_type": "user", "text": "Вчера пропасть актриса лиловый четко сходить.", "date": "2025-07-24 21:16:28"}, {"author_id": 7, "author_type": "staff", "text": "Дошлый выразить способ вздрогнуть порода спорт мелочь применяться трубка деловой.", "date": "2026-05-18 03:22:43"}, {"author_id": 19, "author_type": "user", "text": "Рай основание хотеть миф конструкция нож механический кожа.", "date": "2025-10-11 01:21:16"}]</комментарии_json>
</owl:NamedIndividual>

